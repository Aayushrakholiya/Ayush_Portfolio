{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/resume/:file*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|resume/|assets/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
